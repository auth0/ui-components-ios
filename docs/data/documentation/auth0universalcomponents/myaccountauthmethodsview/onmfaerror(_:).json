":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"type":"reference","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/MfaErrorHandling\/handled","isActive":true},{"type":"text","text":" only when your app takes over. Only "},{"type":"reference","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/MfaError\/noEligibleFactors","isActive":true},{"type":"text","text":" depends"},{"type":"text","text":" "},{"type":"text","text":"on the answer: with "},{"type":"codeVoice","code":".handled"},{"type":"text","text":" the SDK shows nothing more and the app must route the user, and with"},{"type":"text","text":" "},{"type":"codeVoice","code":".notHandled"},{"type":"text","text":" the SDK shows its “not available” screen. Every other error already has its own screen with a"},{"type":"text","text":" "},{"type":"text","text":"way out, so the answer changes nothing for them."}]},{"type":"codeListing","code":["EmbeddedLoginView(connection: \"email\") { credentials in try session.store(credentials) }","    .onMfaError { error in","        analytics.log(error)","        if case .noEligibleFactors = error {","            router.openUniversalLogin()","            return .handled","        }","        return .notHandled","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a handler, an account with no usable factor sees a screen saying so."}]}]}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/MyAccountAuthMethodsView"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onMfaError","kind":"identifier"},{"text":"((","kind":"text"},{"preciseIdentifier":"s