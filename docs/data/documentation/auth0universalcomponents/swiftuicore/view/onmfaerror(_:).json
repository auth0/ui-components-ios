      return .handled","        }","        return .notHandled","    }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a handler, an account with no usable factor sees a screen saying so."}]}]}],"hierarchy":{"paths":[["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/SwiftUICore","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/SwiftUICore\/View"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Reports an MFA flow that ended without signing the user in, and lets the app take over when the component","type":"text"},{"type":"text","text":" "},{"text":"can’t finish, such as ","type":"text"},{"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/MfaError\/noEligibleFactors","type":"reference","isActive":true},{"text":", so the app can fall back to Universal Login.","type":"text"}],"identifier":{"url":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/SwiftUICore\/View\/onMfaError(_:)","interfaceLanguage":"swift"},"references":{"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/MfaError/noEligibleFactors":{"kind":"symbol","title":"MfaError.noEligibleFactors","abstract":[{"text":"Nothing this version can verify. Fall back to Universal Login.","type":"text"}],"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/MfaError\/noEligibleFactors","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"noEligibleFactors"}],"url":"\/documentation\/auth0universalcomponents\/mfaerror\/noeligiblefactors"},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/MfaErrorHandling":{"role":"symbol