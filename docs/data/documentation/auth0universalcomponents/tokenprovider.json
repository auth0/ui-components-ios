text","text":")"}],"abstract":[{"text":"Stores API credentials for a specific audience and scope.","type":"text"}]},"doc://com.auth0.Auth0UniversalComponents/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/s16SendableMetatypeP"},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/Auth0/CredentialsManager":{"url":"\/documentation\/auth0universalcomponents\/auth0\/credentialsmanager","abstract":[{"type":"text","text":"Extension making Auth0’s CredentialsManager conform to the TokenProvider protocol."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CredentialsManager"}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:5Auth018CredentialsManagerV","text":"CredentialsManager"}],"kind":"symbol","title":"CredentialsManager","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/Auth0\/CredentialsManager","type":"topic"},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/TokenProvider/storeCredentials(credentials:)":{"required":true,"role":"symbol","url":"\/documentation\/auth0universalcomponents\/tokenprovider\/storecredentials(credentials:)","type":"topic","abstract":[{"type":"text","text":"Stores user credentials for later retrieval."}],"title":"storeCredentials(credentials:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"storeCredentials","kind":"identifier"},{"text":"(","kind":"text"},{"text":"credentials","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Credentials","preciseIdentifier":"c:@M@Auth0@objc(cs)A0Credentials","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/storeCredentials(credentials:)","kind":"symbol"},"doc://com.au