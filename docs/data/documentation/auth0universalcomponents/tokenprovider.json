"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:5Auth014APICredentialsV","kind":"typeIdentifier","text":"APICredentials"}],"type":"topic","title":"fetchAPICredentials(audience:scope:)","kind":"symbol","required":true,"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/fetchAPICredentials(audience:scope:)"},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/Auth0/CredentialsManager":{"url":"\/documentation\/auth0universalcomponents\/auth0\/credentialsmanager","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/Auth0\/CredentialsManager","title":"CredentialsManager","type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:5Auth018CredentialsManagerV","text":"CredentialsManager"}],"navigatorTitle":[{"kind":"identifier","text":"CredentialsManager"}],"kind":"symbol","abstract":[{"type":"text","text":"Extension making Auth0’s CredentialsManager conform to the TokenProvider protocol."}],"role":"symbol"},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/TokenProvider/fetchCredentials()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fetchCredentials","kind":"identifier"},{"text":"() ","kind":"text"},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"c:@M@Auth0@objc(cs)A0Credentials","kind":"typeIdentifier","text":"Credentials"}],"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/fetchCredentials()","title":"fetchCredentials()","abstract":[{"text":"Fetches the current user credentials from storage.","type":"text"}],"type":"topic","kind":"symbol","url":"\/d