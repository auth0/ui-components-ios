 return cached","        }","        \/\/ Fetch new API credentials","        let credentials = try await Auth0.authentication()","            .credentials(forAudience: audience, scope: scope)","        store(apiCredentials: credentials, for: audience, andScope: scope)","        return credentials","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Dependencies: Requires Auth0 SDK framework"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/TokenProvider/storeCredentials(credentials:)":{"role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"Stores user credentials for later retrieval.","type":"text"}],"url":"\/documentation\/auth0universalcomponents\/tokenprovider\/storecredentials(credentials:)","required":true,"title":"storeCredentials(credentials:)","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/storeCredentials(credentials:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"storeCredentials","kind":"identifier"},{"text":"(","kind":"text"},{"text":"credentials","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@M@Auth0@objc(cs)A0Credentials","text":"Credentials","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://com.auth0.Auth0UniversalComponents/s8SendableP":{"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/TokenProvider/fetchCredentials()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fetchCredentials","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"c:@M@Auth0@objc(cs)A0Cre