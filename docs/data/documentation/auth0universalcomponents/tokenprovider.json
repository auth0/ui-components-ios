{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"text":"This protocol defines the interface for credential management operations used by Auth0 UI Components.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Implementers are responsible for fetching, storing, and managing user credentials and API tokens."},{"type":"text","text":" "},{"type":"text","text":"Must conform to Sendable for use in async\/await contexts and thread-safe operations."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example:"}]},{"type":"codeListing","syntax":"swift","code":["class MyTokenProvider: TokenProvider {","    private let credentialsManager = CredentialsManager(authentication: Auth0.authentication())","    private var apiCredentialsCache: [String: APICredentials] = [:]","","    func fetchCredentials() async throws -> Credentials {","        guard let credentials = try credentialsManager.credentials() else {","            throw NSError(domain: \"TokenProvider\", code: -1, userInfo: nil)","        }","        return credentials","    }","","    func storeCredentials(credentials: Credentials) {","        try? credentialsManager.store(credentials: credentials)","    }","","    func store(apiCredentials: APICredentials, for audience: String, andScope scope: String) {","        apiCredentialsCache[\"\\(audience)_\\(scope)\"] = apiCredentials","    }","","    func fetchAPICredentials(audience: String, scope: String) async throws -> APICredentials {","        if let cached = apiCredentialsCache[\"\\(audience)_\\(scope)\"] {","            return cached","        }","        \/\/ Fetch new API credentials","        let credentials = try await Auth0.authentication()","            .credentials(forAudience: audience, scope: scope)","        store(apiCredentials: credentials, for: audience, andScope: scope)","        return credentials","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dependencies: Requires Auth0 SDK framework"}]}],"kind":"content"}],"metadata":{"modules":[{"name":"Auth0UniversalComponents"}],"externalID":"s:24Auth0UniversalComponents13TokenProviderP","roleHeading":"Protocol","title":"TokenProvider","navigatorTitle":[{"text":"TokenProvider","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TokenProvider"}],"role":"symbol","symbolKind":"protocol"},"references":{"doc://com.auth0.Auth0UniversalComponents/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/s8SendableP","title":"Swift.Sendable"},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/TokenProvider/store(apiCredentials:for:andScope:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"store","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiCredentials","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:5Auth014APICredentialsV","text":"APICredentials","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"andScope","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/store(apiCredentials:for:andScope:)","abstract":[{"type":"text","text":"Stores API credentials for a specific audience and scope."}],"type":"topic","title":"store(apiCredentials:for:andScope:)","kind":"symbol","url":"\/documentation\/auth0universalcomponents\/tokenprovider\/store(apicredentials:for:andscope:)","required":true},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents":{"ki