{"sections":[],"identifier":{"url":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider","interfaceLanguage":"swift"},"kind":"symbol","topicSections":[{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/fetchAPICredentials(audience:scope:)","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/fetchCredentials()","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/store(apiCredentials:for:andScope:)","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/storeCredentials(credentials:)"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/auth0universalcomponents\/tokenprovider"]}],"hierarchy":{"paths":[["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"relationshipsSections":[{"title":"Inherits From","kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/com.auth0.Auth0UniversalComponents\/s8SendableP","doc:\/\/com.auth0.Auth0UniversalComponents\/s16SendableMetatypeP"]},{"title":"Conforming Types","kind":"relationships","type":"conformingTypes","identifiers":["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/Auth0\/CredentialsManager"]}],"abstract":[{"text":"Protocol for managing authentication credentials and tokens.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TokenProvider"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"text":"This protocol defines the interface for credential management operations used by Auth0 UI Components.","type":"text"},{"text":" ","type":"text"},{"text":"Implementers are responsible for fetching, storing, and managing user credentials and API tokens.","type":"text"},{"text":" ","type":"text"},{"text":"Must conform to Sendable for use in async\/await contexts and thread-safe operations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Example:","type":"text"}],"type":"paragraph"},{"code":["class MyTokenProvider: TokenProvider {","    private let credentialsManager = CredentialsManager(authentication: Auth0.authentication())","    private var apiCredentialsCache: [String: APICredentials] = [:]","","    func fetchCredentials() async throws -> Credentials {","        guard let credentials = try credentialsManager.credentials() else {","            throw NSError(domain: \"TokenProvider\", code: -1, userInfo: nil)","        }","        return credentials","    }","","    func storeCredentials(credentials: Credentials) {","        try? credentialsManager.store(credentials: credentials)","    }","","    func store(apiCredentials: APICredentials, for audience: String, andScope scope: String) {","        apiCredentialsCache[\"\\(audience)_\\(scope)\"] = apiCredentials","    }","","    func fetchAPICredentials(audience: String, scope: String) async throws -> APICredentials {","        if let cached = apiCredentialsCache[\"\\(audience)_\\(scope)\"] {","            return cached","        }","        \/\/ Fetch new API credentials","        let credentials = try await Auth0.authentication()","            .credentials(forAudience: audience, scope: scope)","        store(apiCredentials: credentials, for: audience, andScope: scope)","        return credentials","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Dependencies: Requires Auth0 SDK framework","type":"text"}],"type":"paragraph"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TokenProvider"}],"role":"symbol","modules":[{"name":"Auth0UniversalComponents"}],"navigatorTitle":[{"text":"TokenProvider","kind":"identifier"}],"roleHeading":"Protocol","title":"TokenProvider","symbolKind":"protocol","externalID":"s:24Auth0UniversalComponents13TokenProviderP"},"references":{"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/TokenProvider/store(apiCredentials:for:andScope:)":{"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/store(apiCredentials:for:andScope:)","kind":"symbol","required":true,"role":"symbol","title":"store(apiCredentials:for:andScope:)","abstract":[{"text":"Stores API credentials for a specific audience and scope.","type":"text"}],"url":"\/documentation\/auth0universalcomponents\/tokenprovider\/store(apicredentials:for:andscope:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"store"},{"kind":"text","text":"("},{"kind":"externalParam","text":"apiCredentials"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Auth014APICredentialsV","text":"APICredentials"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"andScope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}]},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/TokenProvider/fetchAPICredentials(audience:scope:)":{"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/fetchAPICredentials(audience:scope:)","kind":"symbol","required":true,"role":"symbol","title":"fetchAPICredentials(audience:scope:)","abstract":[{"text":"Fetches API credentials for a specific audience and scope.","type":"text"}],"url":"\/documentation\/auth0universalcomponents\/tokenprovider\/fetchapicredentials(audience:scope:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fetchAPICredentials"},{"kind":"text","text":"("},{"kind":"externalParam","text":"audience"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Auth014APICredentialsV","text":"APICredentials"}]},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/TokenProvider/fetchCredentials()":{"url":"\/documentation\/auth0universalcomponents\/tokenprovider\/fetchcredentials()","required":true,"role":"symbol","abstract":[{"text":"Fetches the current user credentials from storage.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fetchCredentials"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@Auth0@objc(cs)A0Credentials","text":"Credentials"}],"title":"fetchCredentials()","type":"topic","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/fetchCredentials()"},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/TokenProvider":{"title":"TokenProvider","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TokenProvider"}],"navigatorTitle":[{"kind":"identifier","text":"TokenProvider"}],"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider","kind":"symbol","role":"symbol","url":"\/documentation\/auth0universalcomponents\/tokenprovider","abstract":[{"type":"text","text":"Protocol for managing authentication credentials and tokens."}],"type":"topic"},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/TokenProvider/storeCredentials(credentials:)":{"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/storeCredentials(credentials:)","kind":"symbol","required":true,"role":"symbol","title":"storeCredentials(credentials:)","abstract":[{"text":"Stores user credentials for later retrieval.","type":"text"}],"url":"\/documentation\/auth0universalcomponents\/tokenprovider\/storecredentials(credentials:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"storeCredentials"},{"kind":"text","text":"("},{"kind":"externalParam","text":"credentials"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@Auth0@objc(cs)A0Credentials","text":"Credentials"},{"kind":"text","text":")"}]},"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents":{"kind":"symbol","role":"collection","title":"Auth0UniversalComponents","abstract":[{"text":"SDK for Apple platforms.","type":"text"}],"type":"topic","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents","url":"\/documentation\/auth0universalcomponents"},"doc://com.auth0.Auth0UniversalComponents/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/com.aut