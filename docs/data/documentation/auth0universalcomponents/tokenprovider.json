{"abstract":[{"text":"Protocol for managing authentication credentials and tokens.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","topicSections":[{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/fetchAPICredentials(audience:scope:)","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/fetchCredentials()","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/store(apiCredentials:for:andScope:)","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/storeCredentials(credentials:)"]}],"hierarchy":{"paths":[["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents"]]},"identifier":{"url":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider","interfaceLanguage":"swift"},"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/com.auth0.Auth0UniversalComponents\/s8SendableP","doc:\/\/com.auth0.Auth0UniversalComponents\/s16SendableMetatypeP"]},{"type":"conformingTypes","kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/Auth0\/CredentialsManager"]}],"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TokenProvider","kind":"identifier"}],"navigatorTitle":[{"text":"TokenProvider","kind":"identifier"}],"roleHeading":"Protocol","symbolKind":"protocol","title":"TokenProvider","modules":[{"name":"Auth0UniversalComponents"}],"externalID":"s:24Auth0UniversalComponents13TokenProviderP","role":"symbol"},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TokenProvider","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This protocol defines the interface for credential management operations used by Auth0 UI Components."},{"type":"text","text":" "},{"type":"text","text":"Implementers are responsible for fetching, storing, and managing user credentials and API tokens."},{"type":"text","text":" "},{"type":"text","text":"Must conform to Sendable for use in async\/await contexts and thread-safe operations."}],"type":"paragraph"},{"inlineContent":[{"text":"Example:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["class MyTokenProvider: TokenProvider {","    private let credentialsManager = CredentialsManager(authentication: Auth0.authentication())","    private var apiCredentialsCache: [String: APICredentials] = [:]","","    func fetchCredentials() async throws -> Credentials {","        guard let credentials = try credentialsManager.credentials() else {","            throw NSError(domain: \"TokenProvider\", code: -1, userInfo: nil)","        }","        return credentials","    }","","    func storeCredentials(credentials: Credentials) {","        try? credentialsManager.store(credentials: credentials)","    }","","    func store(apiCredentials: APICredentials, for audience: String, andScope scope: String) {","        apiCredentialsCache[\"\\(audience)_\\(scope)\"] = apiCredentials","    }","","    func fetchAPICredentials(audience: String, scope: String) async throws -> APICredentials {","        if let cached = apiCredentialsCache[\"\\(audience)_\\(scope)\"] {","            return cached","        }","        \/\/ Fetch new API credentials","        let credentials = try await Auth0.authentication()","            .credentials(forAudience: audience, scope: scope)","        store(apiCredentials: credentials, for: audience, andScope: scope)","        return credentials","    }","}"]},{"inlineContent":[{"type":"text","text":"Dependencies: Requires Auth0 SDK framework"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/auth0universalcomponents\/tokenprovider"]}],"sections":[],"references":{"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/TokenProvider/fetchAPICredentials(audience:scope:)":{"url":"\/documentation\/auth0universalcomponents\/tokenprovider\/fetchapicredentials(audience:scope:)","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/fetchAPICredentials(audience:scope:)","title":"fetchAPICredentials(audience:scope:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fetchAPICredentials","kind":"identifier"},{"text":"(","kind":"text"},{"text":"audience","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:5Auth014APICredentialsV","text":"APICredentials","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Fetches API credentials for a specific audience and scope."}],"required":true,"kind":"symbol"},"doc://com.auth0.Auth0UniversalComponents/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/s8SendableP"},"doc://com.auth0.Auth0UniversalComponents/d