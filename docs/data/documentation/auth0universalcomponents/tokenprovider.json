{"metadata":{"role":"symbol","roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TokenProvider"}],"navigatorTitle":[{"kind":"identifier","text":"TokenProvider"}],"externalID":"s:24Auth0UniversalComponents13TokenProviderP","modules":[{"name":"Auth0UniversalComponents"}],"title":"TokenProvider","symbolKind":"protocol"},"kind":"symbol","identifier":{"url":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider","interfaceLanguage":"swift"},"sections":[],"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/com.auth0.Auth0UniversalComponents\/s8SendableP","doc:\/\/com.auth0.Auth0UniversalComponents\/s16SendableMetatypeP"],"kind":"relationships","type":"inheritsFrom"},{"kind":"relationships","title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/Auth0\/CredentialsManager"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/auth0universalcomponents\/tokenprovider"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Protocol for managing authentication credentials and tokens.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents"]]},"topicSections":[{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/fetchAPICredentials(audience:scope:)","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/fetchCredentials()","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/TokenProvider\/store(apiCredentials:for:andScope:)","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/Token