nd":"text"},{"text":"EmbeddedLoginView","kind":"identifier"}],"platforms":["iOS"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"The first screen asks for whichever the tenant lists first, with a button for the other when it offers both."},{"type":"text","text":" "},{"type":"text","text":"When the tenant asks for more than the one-time code, the login hands over to the MFA flow in place. Report flows"},{"type":"text","text":" "},{"text":"that can’t finish with ","type":"text"},{"type":"codeVoice","code":"onMfaError(_:)"},{"type":"text","text":", and brand or replace the MFA screens through "},{"type":"codeVoice","code":"mfa"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The SDK stores nothing. When the user is signed in, the credentials go to "},{"type":"codeVoice","code":"onAuthenticated"},{"type":"text","text":", once, and keeping"},{"type":"text","text":" "},{"type":"text","text":"them is the app’s job."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This view is where the two pieces are put together. The login and the MFA Core don’t know each other: the login"},{"text":" ","type":"text"},{"type":"text","text":"only has a contract for “an additional step runs here”, and "},{"type":"codeVoice","code":"EmbeddedMfaStep"},{"type":"text","text":" fills it."}],"type":"paragraph"}]}],"references":{"doc://com.auth0.Auth0UniversalComponents/documentation/Auth0UniversalComponents/EmbeddedLoginView/init(connection:mfa:onAuthenticated:)":{"title":"init(connection:mfa:onAuthenticated:)","role":"symbol","url":"\/documentation\/auth0universalcomponents\/embeddedloginview\/init(connection:mfa:onauthenticated:)","kind":"symbol","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"connection"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String",