{"abstract":[{"type":"text","text":"Reports an MFA flow that ended without signing the user in, and lets the app take over when the component"},{"type":"text","text":" "},{"type":"text","text":"can’t finish, such as "},{"type":"reference","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/MfaError\/noEligibleFactors","isActive":true},{"type":"text","text":", so the app can fall back to Universal Login."}],"hierarchy":{"paths":[["doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents","doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/LoginInlineError"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onMfaError"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"action"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","preciseIdentifier":"s:24Auth0UniversalComponents8MfaErrorO","text":"MfaError","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/MfaError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:24Auth0UniversalComponents16MfaErrorHandlingO","text":"MfaErrorHandling","identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/MfaErrorHandling"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"},{"text":"\n","kind":"text"}],"platforms":["iOS"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A cancel isn’t reported: the user is still inside the login. Handle the cases you care about; later releases"},{"type":"text","text":" "},{"type":"text","text":"may add cases, so use "},{"type":"codeVoice","code":"@unknown default"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/MfaErrorHandling\/handled"},{"type":"text","text":" only when your app takes over. Only "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.auth0.Auth0UniversalComponents\/documentation\/Auth0UniversalComponents\/MfaError\/noEligibleFactors"},{"type":"text","text":" depends"},{"type":"text","text":" "},{"type":"text","text":"on the answer: with "},{"code":".handled","type":"codeVoice"},{"type":"text","text":" the SDK shows nothing more and the app must route the user, and with"},{"type":"text","text":" "},{"code":".notHandled","type":"codeVoice"},{"type":"text","text":" the SDK shows its “not available” screen. Every other error already has its own screen with a"},{"type":"text","text":" "},{"type":"text","text":"way out, so the answer changes nothing for them."}]},{"type":"codeListing","syntax":"swift","code":["EmbeddedLoginView(connection: \"email\") { credentials in try session.store(credentials) }","    .onMfaError { error in","        analytics.log(error)","        if case .noEligibleFactors = error {","            router.openUniversalLogin()","            return .handled","        }","        return .notHandled","    }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a handler, an account with no usable factor sees a screen saying so."}]}]}],"variants":[{"paths":["\/documentation\/auth0universalcomponents\/logininlineerror\/onmfa