require 'json'

default_platform :ios

platform :ios do
  desc "Tags the release and publishes it to GitHub (no CocoaPods)"
  lane :release do
    version = current_version
    UI.header "Performing release for version #{version} 🏗"
    add_git_tag(tag: version)
    push_git_tags(remote: 'origin', tag: version)

    UI.header "Publishing release #{version} 📨"
    github_token = ENV['GITHUB_TOKEN'] || ENV['AUTH0_SHIPPER_GITHUB_TOKEN']
    changelog = Fastlane::Helper::Auth0ShipperHelper.get_changelog(version, File.join(File.dirname(__FILE__), '..', 'CHANGELOG.md'))
    set_github_release(
      repository_name: 'auth0/ui-components-ios',
      api_token: github_token,
      name: version,
      tag_name: version,
      description: changelog,
      server_url: 'https://api.github.com'
    ) unless github_token.nil?
    UI.success "Shipped #{version}! 🚀"
  end

  desc 'Generate API documentation'
  lane :build_docs do
    target = 'Auth0UniversalComponents'
    docs_dir = 'docs'
    docs_archive = 'docs.archive'
    redirect_file = <<~HEREDOC
      <!DOCTYPE html>
        <head>
          <meta http-equiv="refresh" content="0; url=documentation/#{target.downcase}/" />
        </head>
        <body>
          <a href="documentation/#{target.downcase}/">Redirect</a>
        </body>
      </html>
    HEREDOC
    # Work from project root (defaults to /fastlane)
    Dir.chdir('..') do
      # Clear existing docs, or create docs folder if it doesn't already exist
      Dir.exist?(docs_dir) ? FileUtils.rm_r(docs_dir) : FileUtils.mkdir(docs_dir)
      # Generate the .doccarchive
      sh "xcodebuild docbuild -scheme #{target}.iOS -configuration Release -destination 'generic/platform=iOS' -derivedDataPath #{docs_archive} FRAMEWORK_SEARCH_PATHS='Carthage/Build/**'"
      # Every public SwiftUI view inherits ~770 `View` modifiers, and each one becomes a DocC page (JSON and HTML).
      # Drop those synthesized members from the symbol graphs and rebuild the archive from what is left.
      archive = "#{docs_archive}/Build/Products/Release-iphoneos/#{target}.doccarchive"
      symbol_graphs = "#{docs_archive}/Build/Intermediates.noindex/#{target}.build/Release-iphoneos/#{target}.iOS.build/symbol-graph"
      filtered_graphs = "#{docs_archive}/symbol-graph-filtered"
      strip_synthesized_symbols(symbol_graphs, filtered_graphs)
      FileUtils.rm_rf(archive)
      sh "$(xcrun --find docc) convert Documentation.docc --emit-lmdb-index --fallback-display-name #{target} --fallback-bundle-identifier com.auth0.#{target} --additional-symbol-graph-dir #{filtered_graphs} --output-dir #{archive}"
      # Generate the static site
      sh "$(xcrun --find docc) process-archive transform-for-static-hosting #{archive} --hosting-base-path #{target}.swift --output-path #{docs_dir}"
      # Write redirect file
      File.write("#{docs_dir}/index.html", redirect_file)
    end
  end

  # Copies the symbol graphs in `source` to `destination` without the members the compiler synthesizes onto
  # each type (such as SwiftUI's inherited `View` modifiers). Members the SDK declares itself are kept.
  def strip_synthesized_symbols(source, destination)
    FileUtils.rm_rf(destination)
    synthesized = ->(id) { id.to_s.include?('::SYNTHESIZED::') }
    removed = 0
    Dir.glob(File.join(source, '**', '*.symbols.json')).each do |path|
      graph = JSON.parse(File.read(path))
      before = graph['symbols'].size
      graph['symbols'].reject! { |symbol| synthesized.call(symbol.dig('identifier', 'precise')) }
      graph['relationships']&.reject! { |relationship| synthesized.call(relationship['source']) || synthesized.call(relationship['target']) }
      removed += before - graph['symbols'].size
      output = File.join(destination, path.delete_prefix("#{source}/"))
      FileUtils.mkdir_p(File.dirname(output))
      File.write(output, JSON.generate(graph))
    end
    UI.message "Removed #{removed} synthesized symbols from the symbol graphs"
  end

  # Reads the SDK version from the `version` literal in Version.swift,
  # which is the source of truth bumped by Ship (see .shiprc).
  def current_version
    contents = File.read(File.join(File.dirname(__FILE__), '..', 'Auth0UniversalComponents', 'Version.swift'))
    match = contents.match(/let version = "([^"]+)"/)
    UI.user_error!('Cannot find version in Auth0UniversalComponents/Version.swift') if match.nil?
    match[1]
  end
end
